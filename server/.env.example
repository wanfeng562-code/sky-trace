APP_NAME=Sky-Trace-Server
APP_ENV=development
APP_PROFILE=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

DATA_SOURCE_MODE=hybrid
FETCH_INTERVAL_SECONDS=5

REALTIME_SOURCE=opensky
REALTIME_FALLBACK_TO_MOCK=true

DEV_REALTIME_USE_ACTIVE_WINDOW=true
DEV_REALTIME_ACTIVE_INTERVAL_SECONDS=15
DEV_REALTIME_IDLE_INTERVAL_SECONDS=40
DEV_REALTIME_ACTIVE_START_HOUR=8
DEV_REALTIME_ACTIVE_START_MINUTE=0
DEV_REALTIME_DAILY_BUDGET_CALLS=4000

DEV_REALTIME_INTERVAL_SECONDS=30
DEV_ENVIRONMENT_INTERVAL_SECONDS=300
DEV_COMMERCIAL_INTERVAL_SECONDS=86400

RELEASE_REALTIME_INTERVAL_SECONDS=10
RELEASE_ENVIRONMENT_INTERVAL_SECONDS=120
RELEASE_COMMERCIAL_INTERVAL_SECONDS=86400

HTTP_TIMEOUT_SECONDS=20

OPENSKY_BASE_URL=https://opensky-network.org/api
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_BBOX=21.0,26.0,108.0,116.0

AERODATABOX_API_KEY=
AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com
AERODATABOX_BASE_URL=https://aerodatabox.p.rapidapi.com
AERODATABOX_TEST_PATH=flights/airports/iata/SZX/2026-04-13T00:00/2026-04-13T12:00
AERODATABOX_WITH_LEG=true

AVIATIONSTACK_ACCESS_KEY=
AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1
AVIATIONSTACK_LIMIT=20

OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Guangzhou
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

SQLITE_PATH=./data/sky_trace.db

CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WS_HEARTBEAT_SECONDS=20
