VITE_APP_NAME=Sky-Trace
VITE_API_BASE_URL=
VITE_WS_URL=
VITE_ENABLE_MOCK=false

# ── Map configuration ────────────────────────────────────────────────────────
# Initial map viewport
VITE_MAP_INIT_LNG=113.2644
VITE_MAP_INIT_LAT=23.1291
VITE_MAP_INIT_ZOOM=4

# ── Local HTTP proxy (for tile CDNs blocked in mainland China) ───────────────
# Set to your local proxy address (Clash / V2Ray / etc.), leave empty to disable.
HTTP_PROXY=http://127.0.0.1:7897

# 天地图应用 Key；在开发者控制台申请并限制授权域名
VITE_TIANDITU_KEY=
# 按当前使用的地图服务核实审图号，不得填写示例或其他服务的编号
VITE_MAP_APPROVAL_NUMBER=GS（2026）4921号
VITE_MAP_DEFAULT_STYLE=vector

VITE_MAP_APPROVAL_VECTOR=GS（2026）4921号

VITE_MAP_APPROVAL_IMAGERY=GS（2026）4921号

VITE_MAP_APPROVAL_TERRAIN=GS（2026）4921号

VITE_BACKEND_ENABLED=false
